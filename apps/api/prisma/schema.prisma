generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  runtime                = "nodejs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  scores    Score[]
}

model Score {
  id         String   @id @default(uuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  score      Int
  difficulty String
  map        String   @default("classic")
  weekStart  DateTime
  createdAt  DateTime @default(now())

  @@index([difficulty, map, weekStart])
  @@index([difficulty, map, weekStart, playerId, score])
}

model GameSession {
  id         String    @id @default(uuid())
  playerId   String
  playerName String
  difficulty String
  map        String    @default("classic")
  seed       Int
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  finishedAt DateTime?

  @@index([playerId, createdAt])
  @@index([expiresAt])
}
