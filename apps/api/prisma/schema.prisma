generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  runtime                = "nodejs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  scores    Score[]
}

model Score {
  id         String   @id @default(uuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  score      Int
  difficulty String
  map        String   @default("classic")
  weekStart  DateTime
  createdAt  DateTime @default(now())

  @@index([difficulty, map, weekStart])
}
