{
	"extends": "@tsconfig/node24/tsconfig.json",
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "bundler",
		"ignoreDeprecations": "6.0",
		"sourceMap": true,
		"declarationMap": false,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"types": ["node"],
		"rootDir": "./src",
		"outDir": "./dist"
	},
	"exclude": ["node_modules", "dist", "prisma.config.ts", "oxlint.config.ts", "oxfmt.config.ts"]
}
